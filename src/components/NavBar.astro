---
import { mainNavLinks } from '../data/navigation';
import { clinicData } from '../data/clinic';

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="top-banner">
    <div class="container banner-inner">
      <span class="banner-badge">★ Women-Owned Practice</span>
      <span class="banner-text">Consultations at Meridian Medical Centre, Basavanagudi, Bengaluru</span>
      <a href="/contact" class="banner-link">View Hours & Directions &rarr;</a>
    </div>
  </div>

  <div class="nav-wrapper">
    <div class="container nav-container">
      <a href="/" class="brand-link" aria-label="Dr. Harshitha Jain Home">
        <div class="brand-mark">
          <svg width="28" height="28" viewBox="0 0 48 48" fill="none">
            <rect width="48" height="48" rx="12" fill="#4a7c64"/>
            <path d="M24 10C24 10 16 16 16 26C16 31 19.5 35 24 37C28.5 35 32 31 32 26C32 16 24 10 24 10Z" fill="#e8f3ed"/>
            <path d="M24 17V33M19 25H29" stroke="#35614d" stroke-width="2.5" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="brand-text">
          <span class="brand-name">{clinicData.doctorName}</span>
          <span class="brand-subtitle">Functional Medicine Physician • MBBS Gold Medalist</span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="desktop-nav" aria-label="Main Navigation">
        <ul class="nav-list">
          {mainNavLinks.slice(0, 6).map((link) => {
            const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
            return (
              <li>
                <a href={link.href} class:list={["nav-link", { active: isActive }]}>
                  {link.label}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>

      <!-- Action Button & Mobile Toggle -->
      <div class="nav-actions">
        <a href="/contact#book" class="btn btn-primary btn-sm nav-cta">
          Book Appointment
        </a>
        <button id="mobileMenuBtn" class="mobile-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobileDrawer" class="mobile-drawer" aria-hidden="true">
    <div class="mobile-drawer-inner">
      <ul class="mobile-nav-list">
        {mainNavLinks.map((link) => (
          <li>
            <a href={link.href} class="mobile-nav-link">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="mobile-drawer-cta">
        <a href="/contact#book" class="btn btn-primary" style="width: 100%;">
          Request an Appointment
        </a>
        <div class="mobile-drawer-clinic-info">
          <p><strong>Meridian Medical Centre</strong>, 1st Floor, Armugam Circle, Basavanagudi</p>
          <p class="text-sm">Opens 5 PM Tuesday • By Appointment</p>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    transition: all var(--transition-normal);
  }

  .top-banner {
    background: var(--color-brand-sage-dark);
    color: #e3efe8;
    font-size: 0.785rem;
    padding: 6px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 639px) {
    .top-banner {
      display: none;
    }
  }

  .banner-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .banner-badge {
    background: rgba(255, 255, 255, 0.16);
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    font-weight: 600;
    letter-spacing: 0.03em;
  }

  .banner-text {
    display: none;
    opacity: 0.92;
  }

  @media (min-width: 768px) {
    .banner-text {
      display: inline-block;
    }
  }

  .banner-link {
    color: #ffd88a;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .banner-link:hover {
    color: #ffffff;
  }

  .nav-wrapper {
    padding: var(--space-3) 0;
  }

  .nav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
  }

  .brand-mark {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-charcoal);
    line-height: 1.15;
  }

  .brand-subtitle {
    font-size: 0.725rem;
    font-weight: 500;
    color: var(--color-brand-sage-dark);
    letter-spacing: 0.01em;
  }

  @media (max-width: 479px) {
    .brand-subtitle {
      display: none;
    }
  }

  /* Desktop Nav */
  .desktop-nav {
    display: none;
  }

  @media (min-width: 1024px) {
    .desktop-nav {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    list-style: none;
  }

  .nav-link {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--color-charcoal);
    padding: 6px 0;
    position: relative;
    transition: color var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--color-brand-sage);
  }

  .nav-link.active {
    color: var(--color-brand-sage-dark);
    font-weight: 600;
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--color-brand-sage);
    border-radius: var(--radius-pill);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .nav-cta {
    display: none;
  }

  @media (min-width: 640px) {
    .nav-cta {
      display: inline-flex;
    }
  }

  /* Mobile Toggle */
  .mobile-toggle {
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    width: 44px;
    height: 44px;
    background: var(--color-brand-sage-light);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 8px;
    cursor: pointer;
  }

  @media (min-width: 1024px) {
    .mobile-toggle {
      display: none;
    }
  }

  .hamburger-bar {
    width: 100%;
    height: 2px;
    background-color: var(--color-charcoal);
    border-radius: var(--radius-pill);
    transition: all var(--transition-fast);
  }

  /* Mobile Drawer */
  .mobile-drawer {
    display: none;
    background: var(--color-white);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-5) 0;
  }

  .mobile-drawer.open {
    display: block;
    animation: fadeIn 0.25s ease-out;
  }

  .mobile-drawer-inner {
    padding: 0 var(--container-padding);
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .mobile-nav-link {
    display: block;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    color: var(--color-charcoal);
    font-size: 1.05rem;
    font-weight: 500;
  }

  .mobile-nav-link:hover {
    background: var(--color-brand-sage-light);
    color: var(--color-brand-sage-dark);
  }

  .mobile-drawer-clinic-info {
    margin-top: var(--space-4);
    font-size: 0.85rem;
    color: var(--color-slate);
    text-align: center;
  }
</style>

<script>
  const toggleBtn = document.getElementById('mobileMenuBtn');
  const drawer = document.getElementById('mobileDrawer');

  if (toggleBtn && drawer) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = drawer.classList.toggle('open');
      toggleBtn.setAttribute('aria-expanded', String(isOpen));
      drawer.setAttribute('aria-hidden', String(!isOpen));
    });
  }
</script>
