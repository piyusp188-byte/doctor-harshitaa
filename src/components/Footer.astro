---
import { clinicData } from '../data/clinic';
import { footerQuickLinks, footerLegalLinks } from '../data/navigation';
import { conditionsData } from '../data/conditions';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <!-- Top Accent Bar -->
  <div class="footer-top-accent"></div>

  <div class="container footer-main">
    <div class="footer-grid">
      <!-- Col 1: Brand & Practice Identity -->
      <div class="footer-col brand-col">
        <div class="footer-brand">
          <div class="brand-mark">
            <svg width="32" height="32" viewBox="0 0 48 48" fill="none">
              <rect width="48" height="48" rx="12" fill="#4a7c64"/>
              <path d="M24 10C24 10 16 16 16 26C16 31 19.5 35 24 37C28.5 35 32 31 32 26C32 16 24 10 24 10Z" fill="#e8f3ed"/>
              <path d="M24 17V33M19 25H29" stroke="#35614d" stroke-width="2.5" stroke-linecap="round"/>
            </svg>
          </div>
          <div>
            <h4 class="footer-doctor-name">{clinicData.doctorName}</h4>
            <p class="footer-doctor-title">Functional Medicine Physician</p>
          </div>
        </div>

        <p class="footer-bio">
          MBBS Gold Medalist combining conventional medicine with evidence-based functional medicine to investigate and resolve the root causes of chronic illness.
        </p>

        <div class="footer-badges">
          <span class="badge badge-gold">★ MBBS Gold Medalist</span>
          <span class="badge badge-sage">Women-Owned Clinic</span>
        </div>

        <!-- Social Links: Instagram & LinkedIn -->
        <div class="footer-social-links">
          <a 
            href={clinicData.socials.instagram} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="social-btn instagram"
            aria-label="Follow Dr. Harshitha Jain on Instagram"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
            <span>Instagram</span>
          </a>

          <a 
            href={clinicData.socials.linkedin} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="social-btn linkedin"
            aria-label="Connect with Dr. Harshitha Jain on LinkedIn"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
              <rect x="2" y="9" width="4" height="12"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
            <span>LinkedIn</span>
          </a>
        </div>

        <!-- Registration Number Callout (NMC Compliance) -->
        <div class="registration-box">
          <span class="reg-label">Medical Registration:</span>
          <span class="reg-value">{clinicData.registrationNumber.number}</span>
        </div>
      </div>

      <!-- Col 2: Clinic Location & Hours -->
      <div class="footer-col">
        <h4 class="footer-heading">Clinic & Hours</h4>
        <address class="footer-address">
          <strong>Meridian Medical Centre</strong><br />
          First Floor, 3/4, Armugam Circle<br />
          <span class="landmark">Above Shah Medicals</span><br />
          Basavanagudi, Bengaluru, Karnataka 560004<br />
          <span class="plus-code">Plus Code: <strong>{clinicData.plusCode}</strong></span>
        </address>

        <div class="footer-hours">
          <p class="hours-title"><strong>Consultation Hours:</strong></p>
          <p class="hours-text">Mon – Fri: 5:30 PM – 8:00 PM</p>
          <p class="hours-text">Saturday: 10:00 AM – 2:00 PM</p>
          <p class="hours-text-closed">Sunday: Closed</p>
          <p class="hours-note text-sm">
            Consultations are by prior appointment.
          </p>
        </div>

        <div class="footer-map-action">
          <a href={clinicData.googleMapsShareUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">
            <span>Open in Google Maps</span> &rarr;
          </a>
        </div>
      </div>

      <!-- Col 3: Key Focus Areas -->
      <div class="footer-col">
        <h4 class="footer-heading">Focus Areas</h4>
        <ul class="footer-links-list">
          {conditionsData.map((condition) => (
            <li>
              <a href={`/conditions/${condition.slug}`}>{condition.title}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Quick Navigation & Contact -->
      <div class="footer-col">
        <h4 class="footer-heading">Navigation & Contact</h4>
        <ul class="footer-links-list">
          {footerQuickLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>

        <div class="footer-contact-items">
          <p>
            <strong>Phone / WhatsApp:</strong><br />
            <a href={`tel:${clinicData.phone.raw}`} class="contact-action-link">
              📞 {clinicData.phone.display}
            </a>
          </p>
          <p>
            <strong>WhatsApp Consultation Chat:</strong><br />
            <a href={`https://wa.me/${clinicData.whatsapp.raw}?text=${encodeURIComponent(clinicData.whatsapp.message)}`} target="_blank" rel="noopener noreferrer" class="contact-action-link wa-link">
              💬 Message on WhatsApp
            </a>
          </p>
          <p>
            <strong>Clinic Email:</strong><br />
            <a href={`mailto:${clinicData.email.display}`} class="contact-action-link">
              ✉️ {clinicData.email.display}
            </a>
          </p>
        </div>
      </div>
    </div>

    <!-- Mandatory Medical Disclaimer & NMC Compliance Banner -->
    <div class="footer-disclaimer-box">
      <div class="disclaimer-header">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
          <line x1="12" y1="9" x2="12" y2="13"></line>
          <line x1="12" y1="17" x2="12.01" y2="17"></line>
        </svg>
        <strong>Important Medical & Regulatory Disclaimer (NMC & DPDP Act 2023)</strong>
      </div>
      <p class="disclaimer-text">
        <strong>Not Emergency Care:</strong> The information provided on this website is for general educational and informational purposes only and does not constitute formal medical advice, diagnosis, or personalized treatment plans. It does not replace an in-person clinical consultation with a registered medical practitioner. If you are experiencing an acute medical emergency, chest pain, difficulty breathing, or severe acute symptoms, please dial <strong>112</strong> immediately or go to the nearest hospital casualty department.
      </p>
      <p class="disclaimer-text">
        <strong>Ethical Medical Communication:</strong> In strict compliance with the National Medical Commission (NMC) Professional Conduct Regulations, this website does not solicit patients, make superlative claims ("best doctor"), promise guaranteed cures, or display before/after outcome claims. Paraphrased review themes are educational summaries of verified public Google Business reviews.
      </p>
    </div>

    <!-- Bottom Legal Bar -->
    <div class="footer-bottom">
      <div class="footer-copyright">
        © {currentYear} Dr. Harshitha Jain, MBBS (Gold Medalist). All rights reserved.
      </div>
      <ul class="footer-legal-links">
        {footerLegalLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #17241e;
    color: #cadfd4;
    padding-top: var(--space-8);
    padding-bottom: calc(var(--space-8) + var(--mobile-bar-height));
    margin-top: auto;
    font-size: 0.92rem;
  }

  @media (min-width: 1024px) {
    .site-footer {
      padding-bottom: var(--space-8);
    }
  }

  .footer-top-accent {
    height: 4px;
    background: linear-gradient(90deg, var(--color-brand-sage), var(--color-brand-teal), var(--color-accent-gold));
    margin-bottom: var(--space-7);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
    margin-bottom: var(--space-8);
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
    }
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .footer-doctor-name {
    color: #ffffff;
    font-size: 1.25rem;
    font-family: var(--font-serif);
  }

  .footer-doctor-title {
    font-size: 0.85rem;
    color: #92bfa9;
  }

  .footer-bio {
    color: #a3c4b5;
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }

  .footer-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: var(--space-4);
  }

  .footer-social-links {
    display: flex;
    gap: 10px;
    margin-bottom: var(--space-4);
  }

  .social-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    font-size: 0.825rem;
    font-weight: 500;
    text-decoration: none;
    color: #ffffff;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    transition: all var(--transition-fast);
  }

  .social-btn:hover {
    background: var(--color-brand-sage);
    border-color: var(--color-brand-sage);
    transform: translateY(-2px);
  }

  .social-btn.instagram:hover {
    background: #e1306c;
    border-color: #e1306c;
  }

  .social-btn.linkedin:hover {
    background: #0077b5;
    border-color: #0077b5;
  }

  .registration-box {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .reg-label {
    color: #8db5a2;
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 0.05em;
  }

  .reg-value {
    color: #ffffff;
    font-weight: 500;
  }

  .footer-heading {
    color: #ffffff;
    font-size: 1.1rem;
    margin-bottom: var(--space-4);
    font-family: var(--font-serif);
  }

  .footer-address {
    font-style: normal;
    color: #a3c4b5;
    line-height: 1.6;
    margin-bottom: var(--space-3);
  }

  .landmark {
    color: #ffd88a;
    font-size: 0.85rem;
  }

  .plus-code {
    display: block;
    margin-top: 4px;
    font-size: 0.825rem;
    color: #93bfa8;
  }

  .footer-hours {
    background: rgba(255, 255, 255, 0.04);
    padding: 12px;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-3);
  }

  .hours-title {
    color: #ffffff;
    font-size: 0.85rem;
    margin-bottom: 4px;
  }

  .hours-text {
    color: #72cca1;
    font-weight: 600;
    font-size: 0.85rem;
    margin-bottom: 2px;
  }

  .hours-text-closed {
    color: #e2a898;
    font-size: 0.825rem;
    margin-bottom: 4px;
  }

  .hours-note {
    font-size: 0.785rem;
    color: #a3c4b5;
    margin-top: 4px;
  }

  .footer-links-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-links-list a {
    color: #b7d6c8;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-links-list a:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  .footer-contact-items {
    margin-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    font-size: 0.88rem;
  }

  .footer-contact-items strong {
    color: #ffffff;
  }

  .contact-action-link {
    color: #9ed4bc;
    text-decoration: none;
    font-weight: 500;
    transition: color var(--transition-fast);
  }

  .contact-action-link:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  .contact-action-link.wa-link {
    color: #4ade80;
  }

  .footer-disclaimer-box {
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    margin-bottom: var(--space-7);
  }

  .disclaimer-header {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #ffd88a;
    font-size: 0.95rem;
    margin-bottom: var(--space-2);
  }

  .disclaimer-text {
    font-size: 0.8rem;
    color: #95b3a4;
    line-height: 1.6;
    margin-bottom: var(--space-2);
  }

  .disclaimer-text:last-child {
    margin-bottom: 0;
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: var(--space-5);
    font-size: 0.825rem;
    color: #7d9e8f;
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
    }
  }

  .footer-legal-links {
    list-style: none;
    display: flex;
    gap: var(--space-4);
  }

  .footer-legal-links a {
    color: #8dafa0;
    text-decoration: none;
  }

  .footer-legal-links a:hover {
    color: #ffffff;
  }
</style>
