---
import { clinicData } from '../data/clinic';

export interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  type?: string;
  schemaType?: "Physician" | "FAQPage" | "MedicalWebPage" | "WebPage";
  faqItems?: { question: string; answer: string }[];
}

const {
  title = "Dr. Harshitha Jain | Functional Medicine Physician, Basavanagudi, Bengaluru",
  description = "MBBS Gold Medalist and Functional Medicine Physician in Basavanagudi, Bengaluru. Science-backed, root-cause care for thyroid, hormones, gut health, sinus, and nervous system regulation.",
  canonicalUrl = Astro.url.href,
  ogImage = "/images/dr-harshitha.jpg",
  type = "website",
  schemaType = "Physician",
  faqItems = []
} = Astro.props;

// Build Schema.org JSON-LD
const basePhysicianSchema = {
  "@context": "https://schema.org",
  "@type": ["Physician", "MedicalClinic", "LocalBusiness"],
  "name": "Dr. Harshitha Jain, Functional Medicine Physician",
  "alternateName": "Dr. Harshitha Jain Clinic",
  "image": "https://drharshithajain.in/images/dr-harshitha.jpg",
  "description": description,
  "medicalSpecialty": "Functional Medicine, Integrative Medicine, General Medicine",
  "telephone": clinicData.phone.raw,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": clinicData.address.line1 + ", " + clinicData.address.line2,
    "addressLocality": clinicData.address.locality,
    "addressRegion": clinicData.address.state,
    "postalCode": clinicData.address.pincode,
    "addressCountry": "IN"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": clinicData.coordinates.lat,
    "longitude": clinicData.coordinates.lng
  },
  "hasMap": clinicData.googleMapsShareUrl,
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": clinicData.rating.score.toString(),
    "reviewCount": clinicData.rating.reviewCount.toString(),
    "bestRating": "5",
    "worstRating": "1"
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "17:30",
      "closes": "20:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Saturday"],
      "opens": "10:00",
      "closes": "14:00"
    }
  ],
  "sameAs": [
    clinicData.socials.instagram,
    clinicData.socials.linkedin,
    clinicData.socials.googleMaps
  ]
};

const faqSchema = faqItems.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
} : null;
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="canonical" href={canonicalUrl} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="robots" content="index, follow" />
<meta name="author" content="Dr. Harshitha Jain" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(ogImage, Astro.url).href} />
<meta property="og:locale" content="en_IN" />
<meta property="og:site_name" content="Dr. Harshitha Jain — Functional Medicine Physician" />

<!-- Twitter Cards -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalUrl} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(ogImage, Astro.url).href} />

<!-- Structured Data / JSON-LD -->
<script type="application/ld+json" set:html={JSON.stringify(basePhysicianSchema)} />
{faqSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
)}
