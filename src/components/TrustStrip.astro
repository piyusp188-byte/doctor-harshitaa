---
import { clinicData } from '../data/clinic';
---

<section class="trust-strip" aria-label="Key Credentials and Practice Highlights">
  <div class="container">
    <div class="trust-grid">
      <!-- Item 1: Gold Medalist -->
      <div class="trust-card">
        <div class="trust-icon gold">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="8" r="7"></circle>
            <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
          </svg>
        </div>
        <div class="trust-details">
          <span class="trust-title">MBBS Gold Medalist</span>
          <span class="trust-sub">Rigorous evidence-based foundation</span>
        </div>
      </div>

      <!-- Item 2: Google 5.0 Reviews -->
      <a href="/testimonials" class="trust-card interactive" aria-label="Read Google Reviews">
        <div class="trust-icon rating">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="#f59e0b">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
        </div>
        <div class="trust-details">
          <div class="rating-row">
            <span class="trust-title">5.0 / 5.0 Rating</span>
            <span class="rating-stars">★★★★★</span>
          </div>
          <span class="trust-sub">6/6 5-star verified reviews on Google</span>
        </div>
      </a>

      <!-- Item 3: Integrative Care -->
      <div class="trust-card">
        <div class="trust-icon sage">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <div class="trust-details">
          <span class="trust-title">Functional Medicine</span>
          <span class="trust-sub">Root-cause investigation & care</span>
        </div>
      </div>

      <!-- Item 4: Location & Women-owned -->
      <div class="trust-card">
        <div class="trust-icon teal">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
        </div>
        <div class="trust-details">
          <span class="trust-title">Basavanagudi, Bengaluru</span>
          <span class="trust-sub">Meridian Medical Centre • Women-Owned</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .trust-strip {
    background: #ffffff;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-4) 0;
  }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .trust-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .trust-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .trust-card {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: background var(--transition-fast);
  }

  .trust-card.interactive:hover {
    background: var(--color-brand-sage-subtle);
  }

  .trust-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .trust-icon.gold {
    background: var(--color-accent-gold-bg);
    color: var(--color-accent-gold);
  }

  .trust-icon.rating {
    background: #fef3c7;
    color: #d97706;
  }

  .trust-icon.sage {
    background: var(--color-brand-sage-light);
    color: var(--color-brand-sage-dark);
  }

  .trust-icon.teal {
    background: var(--color-brand-teal-light);
    color: var(--color-brand-teal);
  }

  .trust-details {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .rating-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .rating-stars {
    color: #f59e0b;
    font-size: 0.85rem;
    letter-spacing: 1px;
  }

  .trust-title {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-charcoal);
  }

  .trust-sub {
    font-size: 0.785rem;
    color: var(--color-slate);
  }
</style>
