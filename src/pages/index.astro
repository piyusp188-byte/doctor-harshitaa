---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustStrip from '../components/TrustStrip.astro';
import AppointmentForm from '../components/AppointmentForm.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import { conditionsData } from '../data/conditions';
import { reviewThemes } from '../data/testimonials';
import { faqList } from '../data/faqs';
import { clinicData } from '../data/clinic';

const homeFaqs = faqList.slice(0, 4);
---

<BaseLayout
  title="Dr. Harshitha Jain | Functional Medicine Physician, Basavanagudi, Bengaluru"
  description="MBBS Gold Medalist and Functional Medicine Physician in Basavanagudi, Bengaluru. Evidence-based root cause care for thyroid, hormones, gut health, sinus, and nervous system regulation."
  faqItems={homeFaqs}
>
  <!-- Hero Section -->
  <section class="hero-section" aria-labelledby="hero-heading">
    <div class="container hero-container">
      <div class="hero-content">
        <div class="hero-eyebrow">
          <span class="badge badge-sage">Integrative & Functional Medicine</span>
          <span class="badge badge-gold">MBBS Gold Medalist</span>
        </div>

        <h1 id="hero-heading" class="hero-title">
          Tired of being told your results are <span class="highlight-serif">“normal”</span> while you still feel unwell?
        </h1>

        <p class="lead hero-lead">
          <strong>Dr. Harshitha Jain</strong> combines conventional medical precision with root-cause functional medicine. Rather than simply suppressing chronic symptoms with repetitive syrups or prescriptions, she investigates <em>why</em> your body is out of balance.
        </p>

        <div class="hero-key-points">
          <div class="hero-point">
            <span class="point-icon">✓</span>
            <span>45–60 min unhurried consultations</span>
          </div>
          <div class="hero-point">
            <span class="point-icon">✓</span>
            <span>Science-backed biomarker analysis</span>
          </div>
          <div class="hero-point">
            <span class="point-icon">✓</span>
            <span>Tailored nutrition, lifestyle & medical care</span>
          </div>
        </div>

        <div class="hero-actions">
          <a href="#appointment-section" class="btn btn-primary btn-lg">
            <span>Request an Appointment</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a href="/functional-medicine" class="btn btn-secondary btn-lg">
            <span>Explore the Approach</span> &rarr;
          </a>
        </div>

        <!-- Google Business Rating Micro-Card -->
        <div class="hero-rating-badge">
          <div class="stars">★★★★★</div>
          <div class="rating-text">
            <strong>5.0 / 5.0 Rating</strong> on Google Business (6/6 Five-Star Patient Reviews)
          </div>
        </div>
      </div>

      <!-- Hero Visual -->
      <div class="hero-visual">
        <div class="image-frame">
          <img 
            src="/images/dr-harshitha.jpg" 
            alt="Dr. Harshitha Jain, MBBS Gold Medalist and Functional Medicine Physician in her Bengaluru clinic" 
            width="600" 
            height="700" 
            class="hero-img"
            loading="eager"
          />
          <div class="image-accent-card">
            <span class="accent-title">Dr. Harshitha Jain</span>
            <span class="accent-sub">MBBS (Gold Medalist)</span>
            <span class="accent-loc">Basavanagudi, Bengaluru</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Credibility & Trust Strip -->
  <TrustStrip />

  <!-- Core Approach Section: A Different Kind of Medicine -->
  <section class="section approach-section" aria-labelledby="approach-heading">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Integrative Philosophy</span>
        <h2 id="approach-heading" class="section-title">A Different Kind of Medical Care</h2>
        <p class="section-description">
          Conventional medicine saves lives during acute crises. For chronic, lingering health conditions, functional medicine asks deeper questions to restore full cellular vitality.
        </p>
      </div>

      <div class="grid-3 approach-grid">
        <!-- Card 1 -->
        <div class="card approach-card">
          <div class="approach-num">01</div>
          <div class="approach-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
          </div>
          <h3>Listen Deeply & Completely</h3>
          <p>
            Your health history is an interconnected story, not isolated complaints. Consultations are unhurried (45–60 minutes) to understand your stress, diet, sleep, and symptom timeline.
          </p>
        </div>

        <!-- Card 2 -->
        <div class="card approach-card">
          <div class="approach-num">02</div>
          <div class="approach-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </div>
          <h3>Investigate the Root Cause</h3>
          <p>
            Rather than reflexively prescribing another antacid or anti-allergic syrup, we analyze full thyroid panels, gut microbiome balance, micronutrient reserves, and systemic inflammation.
          </p>
        </div>

        <!-- Card 3 -->
        <div class="card approach-card">
          <div class="approach-num">03</div>
          <div class="approach-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
          </div>
          <h3>Heal Holistically & Sustainably</h3>
          <p>
            Your care plan combines evidence-grounded nutritional guidance, restorative lifestyle pacing, nervous system regulation, and targeted botanical or medical therapeutics.
          </p>
        </div>
      </div>

      <div class="approach-cta-box">
        <div class="approach-cta-content">
          <h4>Want to understand how conventional and functional medicine complement each other?</h4>
          <p>Explore our neutral, patient-friendly guide comparing both modalities.</p>
        </div>
        <a href="/functional-medicine" class="btn btn-secondary">Read Full Explainer &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Focus Areas / Conditions Grid -->
  <section class="section conditions-section" aria-labelledby="conditions-heading">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Conditions & Special Focus Areas</span>
        <h2 id="conditions-heading" class="section-title">Root-Cause Care for Chronic Symptoms</h2>
        <p class="section-description">
          Dr. Harshitha works with patients navigating chronic, often unresolved symptoms where standard treatments haven't provided lasting resolution.
        </p>
      </div>

      <div class="grid-3 condition-cards-grid">
        {conditionsData.map((condition) => (
          <div class="card condition-card card-interactive">
            <div class="condition-header">
              <span class="badge badge-teal">{condition.badge}</span>
              <div class="condition-icon" set:html={condition.iconSvg}></div>
            </div>
            <h3 class="condition-title">{condition.title}</h3>
            <p class="condition-desc">{condition.shortDescription}</p>
            <div class="condition-footer">
              <a href={`/conditions/${condition.slug}`} class="condition-link">
                <span>Explore treatment approach</span> &rarr;
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How It Works Section: 3 Clear Steps -->
  <section class="section process-section" aria-labelledby="process-heading">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Your Health Journey</span>
        <h2 id="process-heading" class="section-title">What to Expect During Your Care</h2>
        <p class="section-description">
          A transparent, reassuring 3-step pathway from your first enquiry to lasting vitality.
        </p>
      </div>

      <div class="grid-3 process-grid">
        <div class="process-step-card">
          <div class="step-badge">Step 1</div>
          <h3>Enquire & Pre-Consultation</h3>
          <p>
            Submit your appointment request online or via WhatsApp. Our clinic coordinator will share pre-consultation guidance and assist you in gathering your past laboratory tests.
          </p>
        </div>

        <div class="process-step-card">
          <div class="step-badge">Step 2</div>
          <h3>In-Depth 45–60 Min Consultation</h3>
          <p>
            Meet Dr. Harshitha in person at Meridian Medical Centre, Basavanagudi (or via video). We conduct a deep clinical review of your timeline, nutrition, stress, and bodily systems.
          </p>
        </div>

        <div class="process-step-card">
          <div class="step-badge">Step 3</div>
          <h3>Personalized Action Plan & Review</h3>
          <p>
            Receive a clear, stepwise strategy encompassing root-cause lab investigations, dietary recalibration, nervous system calming, and structured follow-up reviews.
          </p>
        </div>
      </div>

      <div class="text-center" style="margin-top: var(--space-6);">
        <a href="/consultation" class="btn btn-secondary">View Complete Consultation Process &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Paraphrased Patient Review Themes -->
  <section class="section testimonials-section" aria-labelledby="reviews-heading">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Verified Patient Experiences</span>
        <h2 id="reviews-heading" class="section-title">Themes from Google Business Reviews</h2>
        <p class="section-description">
          Dr. Harshitha maintains a <strong>5.0 / 5.0 rating</strong> from verified patient reviews. In accordance with ethical medical communication norms (NMC regulations), themes below are paraphrased from public reviews.
        </p>
      </div>

      <div class="grid-3 review-grid">
        {reviewThemes.slice(0, 3).map((review) => (
          <div class="card review-card">
            <div class="review-stars">★★★★★</div>
            <h4 class="review-title">{review.themeTitle}</h4>
            <p class="review-text">“{review.paraphrasedExperience}”</p>
            <div class="review-footer">
              <span class="review-focus">{review.focusArea}</span>
              <span class="review-source">{review.sourceNote}</span>
            </div>
          </div>
        ))}
      </div>

      <div class="reviews-action-banner">
        <div class="reviews-badge-container">
          <span class="stars-large">★★★★★</span>
          <strong>5.0 out of 5 Stars (6 Reviews)</strong>
        </div>
        <p>Every review received a personalized, thoughtful response directly from the doctor.</p>
        <a 
          href={clinicData.googleMapsShareUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn-secondary"
        >
          Read All Reviews on Google Maps &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Teaser -->
  <section class="section faq-teaser-section" aria-labelledby="faq-heading">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Common Questions</span>
        <h2 id="faq-heading" class="section-title">Frequently Asked Questions</h2>
        <p class="section-description">
          Clear answers about functional medicine, consultations, test reports, and what to expect.
        </p>
      </div>

      <div class="faq-container" style="max-width: 800px; margin: 0 auto;">
        <FAQAccordion items={homeFaqs} defaultOpenIndex={0} />
        
        <div class="text-center" style="margin-top: var(--space-6);">
          <a href="/faq" class="btn btn-secondary">Explore All Questions & Answers &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Appointment Booking Form Section -->
  <section class="section appointment-section" id="appointment-section" aria-labelledby="appointment-heading">
    <div class="container">
      <div class="appointment-layout">
        <div class="appointment-intro">
          <span class="section-eyebrow">Start Your Journey</span>
          <h2 id="appointment-heading" class="section-title">Book an Unhurried Consultation</h2>
          <p class="lead">
            Begin with a doctor who takes the time to listen, investigate, and collaborate on your health goals.
          </p>

          <div class="clinic-contact-cards">
            <div class="clinic-info-card">
              <div class="info-icon">📍</div>
              <div>
                <strong>Clinic Location</strong>
                <p>First Floor, Meridian Medical Centre, 3/4, Armugam Circle, above Shah Medicals, Basavanagudi, Bengaluru 560004</p>
              </div>
            </div>

            <div class="clinic-info-card">
              <div class="info-icon">⏰</div>
              <div>
                <strong>Consultation Hours</strong>
                <p>Monday – Friday: 5:30 PM – 8:00 PM | Saturday: 10:00 AM – 2:00 PM (By Appointment)</p>
              </div>
            </div>

            <div class="clinic-info-card">
              <div class="info-icon">🔒</div>
              <div>
                <strong>DPDP Act 2023 Compliant</strong>
                <p>Your health information is strictly private and safeguarded under Indian data protection laws.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="appointment-form-wrapper">
          <AppointmentForm />
        </div>
      </div>
    </div>
  </section>

  <!-- Location, Map & Directions Section -->
  <section class="section location-section" aria-labelledby="location-heading">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Visit Us</span>
        <h2 id="location-heading" class="section-title">Clinic Location & Directions</h2>
        <p class="section-description">
          Conveniently situated at Armugam Circle, Basavanagudi — accessible from South Bengaluru, Jayanagar, and Gandhi Bazaar.
        </p>
      </div>

      <div class="grid-2 location-grid">
        <!-- Interactive Map Container -->
        <div class="map-card card">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3888.3503259976527!2d77.57529787593683!3d12.93991818737227!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bae158b0f808cb3%3A0x6b77209930f7823e!2sMeridian%20Medical%20Centre!5e0!3m2!1sen!2sin!4v1700000000000!5m2!1sen!2sin" 
            width="100%" 
            height="380" 
            style="border:0; border-radius: var(--radius-md);" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
            title="Google Maps Location of Dr. Harshitha Jain Clinic at Meridian Medical Centre Basavanagudi"
          ></iframe>
        </div>

        <!-- Location Details Card -->
        <div class="card location-details-card">
          <h3>Meridian Medical Centre</h3>
          <p class="clinic-sub">Dr. Harshitha Jain, Functional Medicine Physician</p>

          <div class="address-block">
            <p><strong>Address:</strong></p>
            <p>First Floor, 3/4, Armugam Circle</p>
            <p><span class="landmark-tag">Above Shah Medicals</span></p>
            <p>Basavanagudi, Bengaluru, Karnataka 560004</p>
            <p class="plus-code-row">
              Plus Code: <code>{clinicData.plusCode}</code>
            </p>
          </div>

          <div class="directions-cta">
            <a 
              href={clinicData.googleMapsShareUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn btn-primary"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
              </svg>
              <span>Get Driving Directions</span>
            </a>
            <a href="/contact" class="btn btn-secondary">
              View Clinic Details &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Styles */
  .hero-section {
    padding-top: var(--space-8);
    padding-bottom: var(--space-8);
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 1024px) {
    .hero-section {
      padding-top: var(--space-9);
      padding-bottom: var(--space-9);
    }
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-container {
      grid-template-columns: 1.15fr 0.85fr;
      gap: var(--space-8);
    }
  }

  .hero-eyebrow {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: var(--space-4);
  }

  .hero-title {
    margin-bottom: var(--space-4);
    color: var(--color-charcoal);
  }

  .highlight-serif {
    color: var(--color-brand-sage-dark);
    font-style: italic;
    font-weight: 400;
  }

  .hero-lead {
    margin-bottom: var(--space-5);
    max-width: 620px;
  }

  .hero-key-points {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .hero-point {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: 0.95rem;
    color: var(--color-charcoal);
    font-weight: 500;
  }

  .point-icon {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--color-brand-sage-light);
    color: var(--color-brand-sage-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: bold;
    flex-shrink: 0;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .hero-rating-badge {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    width: fit-content;
  }

  .stars {
    color: #f59e0b;
    letter-spacing: 2px;
    font-size: 1.05rem;
  }

  .rating-text {
    font-size: 0.85rem;
    color: var(--color-charcoal);
  }

  /* Hero Visual */
  .hero-visual {
    position: relative;
  }

  .image-frame {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    border: 4px solid #ffffff;
    background: #ffffff;
  }

  .hero-img {
    width: 100%;
    height: auto;
    object-fit: cover;
    aspect-ratio: 4 / 4.6;
    display: block;
    transition: transform var(--transition-slow);
  }

  .image-accent-card {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid rgba(255, 255, 255, 0.8);
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-md);
  }

  .accent-title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-charcoal);
  }

  .accent-sub {
    font-size: 0.8rem;
    color: var(--color-brand-sage-dark);
    font-weight: 600;
  }

  .accent-loc {
    font-size: 0.75rem;
    color: var(--color-slate);
  }

  .photo-note {
    margin-top: 8px;
    font-size: 0.75rem;
    color: var(--color-slate);
  }

  /* Approach Section */
  .approach-card {
    position: relative;
    padding-top: var(--space-7);
  }

  .approach-num {
    position: absolute;
    top: var(--space-4);
    right: var(--space-5);
    font-family: var(--font-serif);
    font-size: 2.2rem;
    font-weight: 300;
    color: rgba(74, 128, 102, 0.18);
  }

  .approach-icon {
    width: 50px;
    height: 50px;
    border-radius: var(--radius-md);
    background: var(--color-brand-sage-light);
    color: var(--color-brand-sage-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-4);
  }

  .approach-card h3 {
    margin-bottom: var(--space-3);
  }

  .approach-cta-box {
    margin-top: var(--space-7);
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
    justify-content: space-between;
  }

  @media (min-width: 768px) {
    .approach-cta-box {
      flex-direction: row;
      align-items: center;
    }
  }

  .approach-cta-content h4 {
    margin-bottom: 4px;
    font-family: var(--font-serif);
    font-size: 1.15rem;
  }

  .approach-cta-content p {
    font-size: 0.92rem;
  }

  /* Conditions Section */
  .condition-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .condition-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }

  .condition-icon {
    color: var(--color-brand-sage);
  }

  .condition-title {
    font-size: 1.35rem;
    margin-bottom: var(--space-2);
  }

  .condition-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    margin-bottom: var(--space-4);
    flex: 1;
  }

  .condition-footer {
    border-top: 1px solid rgba(152, 185, 168, 0.2);
    padding-top: var(--space-3);
  }

  .condition-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-brand-sage-dark);
  }

  .section-footer-note {
    margin-top: var(--space-6);
  }

  /* Process Section */
  .process-step-card {
    background: #ffffff;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    padding: var(--space-6);
    position: relative;
  }

  .step-badge {
    display: inline-block;
    background: var(--color-brand-sage-light);
    color: var(--color-brand-sage-dark);
    font-size: 0.785rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    margin-bottom: var(--space-3);
  }

  .process-step-card h3 {
    margin-bottom: var(--space-2);
    font-size: 1.25rem;
  }

  .process-step-card p {
    font-size: 0.92rem;
  }

  /* Testimonials */
  .review-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .review-stars {
    color: #f59e0b;
    font-size: 1.1rem;
    letter-spacing: 2px;
    margin-bottom: var(--space-3);
  }

  .review-title {
    font-size: 1.1rem;
    margin-bottom: var(--space-2);
    font-family: var(--font-serif);
  }

  .review-text {
    font-size: 0.92rem;
    font-style: italic;
    color: var(--color-charcoal-muted);
    line-height: 1.65;
