---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | Dr. Harshitha Jain"
  description="The requested page could not be found. Return to Dr. Harshitha Jain's functional medicine practice homepage."
>
  <section class="section text-center" style="padding: var(--space-9) 0;">
    <div class="container" style="max-width: 600px;">
      <span class="badge badge-sage" style="margin-bottom: var(--space-3);">Error 404</span>
      <h1 style="font-size: 2.8rem; margin-bottom: var(--space-3);">Page Not Found</h1>
      <p class="lead" style="margin-bottom: var(--space-6);">
        The page you are looking for may have been moved or is currently unavailable. Let's guide you back to our primary clinical resources.
      </p>

      <div class="actions" style="display: flex; justify-content: center; gap: var(--space-3); flex-wrap: wrap;">
        <a href="/" class="btn btn-primary btn-lg">Return to Homepage &rarr;</a>
        <a href="/contact#book" class="btn btn-secondary btn-lg">Book a Consultation</a>
      </div>
    </div>
  </section>
</BaseLayout>
