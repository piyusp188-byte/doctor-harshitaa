---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustStrip from '../components/TrustStrip.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import { faqList } from '../data/faqs';

const categories = ["Functional Medicine", "Consultations", "Conditions", "General"] as const;
---

<BaseLayout
  title="Frequently Asked Questions | Dr. Harshitha Jain, Bengaluru"
  description="Answers to common questions regarding functional medicine consultations, diagnostic testing, appointment scheduling, and clinic location at Meridian Medical Centre Basavanagudi."
  schemaType="FAQPage"
  faqItems={faqList}
>
  <section class="page-hero">
    <div class="container text-center">
      <span class="section-eyebrow">Patient Resources</span>
      <h1 class="page-title">Frequently Asked Questions</h1>
      <p class="lead" style="max-width: 720px; margin: var(--space-3) auto 0;">
        Clear, transparent information about functional medicine, what to expect during your visits, and how we investigate root causes.
      </p>
    </div>
  </section>

  <TrustStrip />

  <section class="section">
    <div class="container" style="max-width: 860px;">
      {categories.map((category) => {
        const categoryFaqs = faqList.filter((item) => item.category === category);
        return (
          <div class="faq-category-block" id={category.toLowerCase().replace(/\s+/g, '-')}>
            <div class="category-header">
              <span class="badge badge-sage">{category}</span>
              <h2>{category === 'General' ? 'Location & Logistics' : category}</h2>
            </div>
            <FAQAccordion items={categoryFaqs} defaultOpenIndex={category === 'Functional Medicine' ? 0 : -1} />
          </div>
        );
      })}

      <!-- Question Help Box -->
      <div class="card help-card text-center" style="margin-top: var(--space-8);">
        <h3>Have a Specific Health Question?</h3>
        <p class="lead" style="max-width: 600px; margin: var(--space-3) auto var(--space-5);">
          If your question isn't answered above, our clinic coordinator is available to help clarify any details prior to booking.
        </p>
        <div class="help-actions">
          <a href="/contact#book" class="btn btn-primary">Contact the Clinic &rarr;</a>
          <a href="/conditions" class="btn btn-secondary">Explore Focus Areas</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: radial-gradient(circle at 50% 50%, rgba(220, 238, 228, 0.4), transparent 60%);
    padding: var(--space-8) 0 var(--space-7);
    border-bottom: 1px solid var(--color-border);
  }

  .page-title {
    margin-top: var(--space-2);
  }

  .faq-category-block {
    margin-bottom: var(--space-8);
  }

  .category-header {
    margin-bottom: var(--space-4);
  }

  .category-header h2 {
    font-size: 1.6rem;
    margin-top: var(--space-2);
    color: var(--color-brand-sage-dark);
  }

  .help-card {
    background: #ffffff;
    padding: var(--space-7);
  }

  .help-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
