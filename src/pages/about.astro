---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustStrip from '../components/TrustStrip.astro';
import { clinicData } from '../data/clinic';
---

<BaseLayout
  title="About Dr. Harshitha Jain | MBBS Gold Medalist & Functional Medicine Physician"
  description="Learn about Dr. Harshitha Jain, MBBS Gold Medalist and Functional Medicine Physician in Basavanagudi, Bengaluru. Discover her integrative approach combining conventional science with root-cause healing."
>
  <!-- Page Header -->
  <section class="page-hero">
    <div class="container text-center">
      <span class="section-eyebrow">Meet Your Doctor</span>
      <h1 class="page-title">About Dr. Harshitha Jain</h1>
      <p class="lead" style="max-width: 720px; margin: var(--space-3) auto 0;">
        MBBS Gold Medalist and Functional Medicine Physician dedicated to unhurried, science-backed root cause care in Bengaluru.
      </p>
    </div>
  </section>

  <TrustStrip />

  <!-- Doctor Story Section -->
  <section class="section">
    <div class="container">
      <div class="about-grid">
        <div class="about-image-column">
          <div class="about-photo-wrapper">
            <img 
              src="/images/dr-harshitha.jpg" 
              alt="Dr. Harshitha Jain in her consultation office at Meridian Medical Centre" 
              width="600" 
              height="700" 
              class="about-photo"
            />
            <div class="about-badge-card">
              <strong>Dr. Harshitha Jain</strong>
              <span>MBBS Gold Medalist</span>
              <span class="text-sm">Meridian Medical Centre, Basavanagudi</span>
            </div>
          </div>
        </div>

        <div class="about-bio-column">
          <span class="section-eyebrow">The Physician's Journey</span>
          <h2>“I went into medicine to truly help patients heal — not just manage symptoms indefinitely.”</h2>

          <div class="bio-text">
            <p>
              When I completed my MBBS with a <strong>Gold Medal</strong>, I stepped into clinical practice equipped with the rigorous tools of acute diagnosis and conventional pharmacotherapy. Conventional medicine is invaluable: it stabilizes emergencies, cures acute infections, and saves lives every single day.
            </p>

            <p>
              Yet, as the years progressed, I observed a consistent, troubling pattern. Patients arriving with chronic fatigue, erratic thyroid levels, persistent constipation, recurrent sinus congestion, and hormonal mood dips were frequently told: <em>“All your lab tests are normal. Take this antacid, this antihistamine, and this painkiller.”</em>
            </p>

            <p>
              I knew our bodies rarely malfunction without a root physiological driver. That clinical conviction led me to immerse myself in <strong>Functional Medicine</strong>—a science-grounded discipline that investigates the upstream biochemical, digestive, immune, and endocrine imbalances generating chronic illness.
            </p>

            <p>
              Today at Meridian Medical Centre in Basavanagudi, I integrate both paradigms: the diagnostic rigour of modern medicine alongside deep investigative root-cause nutrition, lifestyle medicine, and nervous system restoration.
            </p>
          </div>

          <!-- Credentials Box -->
          <div class="credentials-card">
            <h4>Academic & Clinical Distinction</h4>
            <ul class="credentials-list">
              <li>
                <span class="cred-dot">✓</span>
                <div>
                  <strong>MBBS — Gold Medalist</strong>
                  <p class="text-sm">Awarded gold medal distinction for academic and clinical excellence in medicine.</p>
                </div>
              </li>
              <li>
                <span class="cred-dot">✓</span>
                <div>
                  <strong>Functional & Integrative Medicine Physician</strong>
                  <p class="text-sm">Root-cause investigation, clinical biomarker evaluation, and cellular nutrition.</p>
                </div>
              </li>
              <li>
                <span class="cred-dot">✓</span>
                <div>
                  <strong>Medical Council Registration</strong>
                  <p class="text-sm">Registered Medical Practitioner • Karnataka Medical Council</p>
                </div>
              </li>
              <li>
                <span class="cred-dot">✓</span>
                <div>
                  <strong>Patient-Centered Clinical Care</strong>
                  <p class="text-sm">Unhurried 45–60 minute consultations dedicated to deep listening and thorough clinical review.</p>
                </div>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pull Quote Banner -->
  <section class="pull-quote-section">
    <div class="container">
      <blockquote class="quote-text">
        “Every individual's biochemistry, gut microbiome, and stress history is unique. Real medicine listens to the entire patient story before writing a single prescription.”
      </blockquote>
      <cite class="quote-author">— Dr. Harshitha Jain, MBBS (Gold Medalist)</cite>
    </div>
  </section>

  <!-- Clinical Care & Practice Section -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Clinical Practice</span>
        <h2>In-Person Care at Meridian Medical Centre</h2>
        <p class="section-description">
          A dedicated clinical space in Basavanagudi where patients receive compassionate, comprehensive, and unhurried medical attention.
        </p>
      </div>

      <div class="grid-2 clinic-gallery-grid">
        <div class="clinic-photo-card card">
          <div class="photo-img-wrap">
            <img 
              src="/images/clinic-consultation.jpg" 
              alt="Dr. Harshitha Jain in consultation with a patient at Meridian Medical Centre" 
              width="600" 
              height="400" 
              class="clinic-grid-img"
            />
          </div>
          <div class="photo-card-caption">
            <strong>Unhurried Clinical Consultations:</strong>
            <p>Every consultation involves careful listening, focused physical evaluation, and detailed examination of symptom timelines.</p>
          </div>
        </div>

        <div class="clinic-photo-card card">
          <div class="photo-img-wrap">
            <img 
              src="/images/doctor-award.jpg" 
              alt="Dr. Harshitha Jain receiving academic felicitation and recognition" 
              width="600" 
              height="400" 
              class="clinic-grid-img"
            />
          </div>
          <div class="photo-card-caption">
            <strong>Academic Recognition & Seminars:</strong>
            <p>Regular speaker and clinical educator bridging clinical nutrition, lifestyle interventions, and evidence-based medicine.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section about-cta-section text-center">
    <div class="container">
      <h2>Ready to Explore a Root-Cause Path to Wellness?</h2>
      <p class="lead" style="max-width: 600px; margin: var(--space-3) auto var(--space-6);">
        Schedule your in-person consultation in Basavanagudi, Bengaluru, or connect via video teleconsultation.
      </p>
      <div class="cta-actions">
        <a href="/contact#book" class="btn btn-primary btn-lg">Request an Appointment &rarr;</a>
        <a href="/functional-medicine" class="btn btn-secondary btn-lg">What is Functional Medicine?</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: radial-gradient(circle at 50% 50%, rgba(220, 238, 228, 0.4), transparent 60%);
    padding: var(--space-8) 0 var(--space-7);
    border-bottom: 1px solid var(--color-border);
  }

  .page-title {
    margin-top: var(--space-2);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: flex-start;
  }

  @media (min-width: 1024px) {
    .about-grid {
      grid-template-columns: 0.9fr 1.1fr;
    }
  }

  .about-photo-wrapper {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    border: 4px solid #ffffff;
    background: #ffffff;
  }

  .about-photo {
    width: 100%;
    height: auto;
    object-fit: cover;
    aspect-ratio: 4 / 4.8;
  }

  .about-badge-card {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(12px);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid rgba(255, 255, 255, 0.8);
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-md);
  }

  .about-badge-card strong {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--color-charcoal);
  }

  .about-badge-card span {
    font-size: 0.85rem;
    color: var(--color-brand-sage-dark);
    font-weight: 600;
  }

  .photo-note {
    margin-top: 8px;
    font-size: 0.75rem;
    color: var(--color-slate);
  }

  .about-bio-column h2 {
    font-size: clamp(1.5rem, 2.5vw, 2.1rem);
    line-height: 1.3;
    margin: var(--space-3) 0 var(--space-5);
    color: var(--color-brand-sage-dark);
  }

  .bio-text p {
    margin-bottom: var(--space-4);
    font-size: 1.05rem;
  }

  .credentials-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    margin-top: var(--space-6);
    box-shadow: var(--shadow-sm);
  }

  .credentials-card h4 {
    margin-bottom: var(--space-4);
    font-family: var(--font-serif);
    color: var(--color-charcoal);
  }

  .credentials-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .credentials-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .cred-dot {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--color-brand-sage-light);
    color: var(--color-brand-sage-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: bold;
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* Pull Quote */
  .pull-quote-section {
    background: var(--color-brand-sage-dark);
    color: #ffffff;
    padding: var(--space-8) 0;
    text-align: center;
  }

  .quote-text {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-style: italic;
    font-weight: 300;
    line-height: 1.45;
    max-width: 820px;
    margin: 0 auto var(--space-4);
  }

  .quote-author {
    font-size: 0.95rem;
    color: #c7e0d3;
    letter-spacing: 0.05em;
    font-style: normal;
    text-transform: uppercase;
  }

  /* Clinic Banner */
  .clinic-interior-banner {
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    background: #ffffff;
    border: 1px solid var(--color-border);
  }

  .clinic-wide-img {
    width: 100%;
    height: auto;
    max-height: 480px;
    object-fit: cover;
  }

  .interior-caption {
    padding: var(--space-4) var(--space-6);
    background: #ffffff;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 0.9rem;
  }

  /* CTA */
  .about-cta-section {
    background: #ffffff;
    border-top: 1px solid var(--color-border);
  }

  .cta-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
